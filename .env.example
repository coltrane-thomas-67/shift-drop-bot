# --- Spilt Milk Nannies site ---
SMN_LOGIN_URL=https://REPLACE-ME.spiltmilknannies.com/login
SMN_APPOINTMENTS_URL=https://REPLACE-ME.spiltmilknannies.com/appointment-requests
SMN_USERNAME=your_username_here
SMN_PASSWORD=your_password_here

# --- Monitoring ---
# Base seconds between checks. A small random jitter is added automatically
# so the bot doesn't hammer the site at a perfectly robotic fixed interval.
CHECK_INTERVAL_SECONDS=45
HEADLESS=true

# --- Notifications ---
# "emailToSms" (free forever, recommended default) or "twilio"
NOTIFY_METHOD=emailToSms

# Your phone number, digits only, no country code, e.g. 5551234567
ALERT_PHONE_NUMBER=5551234567

# --- Option A: Email-to-SMS gateway (100% free, uses your Gmail account) ---
# Common US carrier gateway domains:
#   AT&T:        txt.att.net
#   T-Mobile:    tmomail.net
#   Verizon:     vtext.com
#   Sprint:      messaging.sprintpcs.com
#   Boost:       sms.myboostmobile.com
#   Cricket:     sms.cricketwireless.net
#   Google Fi:   msg.fi.google.com
CARRIER_GATEWAY=vtext.com

# Gmail address to send FROM. Use a Gmail App Password (not your real password):
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# --- Option B: Twilio (free trial credit, optional alternative) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
